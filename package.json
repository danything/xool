{
  "name": "xool",
  "version": "0.1.0",
  "devDependencies": {
    "@anyblades/blades": "3.1.0-rc.1",
    "@sveltejs/adapter-bun": "^1.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@7",
    "oxlint": "^1.90.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.5"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "bun --bun vite build",
    "start": "bun build/index.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
    "lint": "oxlint && bun fmt --check",
    "format": "oxlint --fix && bun fmt"
  },
  "type": "module"
}
