		"@typescript/native": "npm:typescript@7",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "~6.0.3",
		"vite": "^8.3.4"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
