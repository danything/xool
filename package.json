	"devDependencies": {
		"@anyblades/blades": "3.1.0-alpha.2",
		"@biomejs/biome": "^2.5.15",
		"@sveltejs/adapter-bun": "^1.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/bun": "^1.4.3",
